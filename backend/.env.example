# Application Configuration Template
PROJECT_NAME="AI-Powered Smart Tourist Guide Platform for Karnataka"
VERSION="0.1.0"
API_V1_STR="/api/v1"
APP_PROFILE=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=karnataka_guide
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Security & JWT Configuration
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap Super Admin (Explicit command usage only)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# PDF Document Storage Configuration
DOCUMENT_STORAGE_DIR=storage/documents
MAX_PDF_UPLOAD_BYTES=52428800

# AI & Vector Store Configuration
CHROMA_PERSIST_DIR=storage/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_TARGET_SIZE=800
CHUNK_OVERLAP=120
