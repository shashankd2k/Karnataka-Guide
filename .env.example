# ==============================================================================
# Karnataka Tourist Guide Platform — Environment Configuration Template
# Copy to .env and configure secret keys before running deployment
# ==============================================================================

# Application Profile: dev | standalone | cloud
APP_PROFILE=standalone

# Web & Port Configuration
PORT=80
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Security & Authentication (Required: minimum 32 characters in standalone/cloud)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Super Admin Initial Bootstrap (Required to create initial administrator account)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD

# MySQL 8.0 Database Credentials
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
DB_NAME=karnataka_guide
DB_USER=karnataka_user
DB_PASSWORD=CHANGE_ME_APP_USER_DATABASE_PASSWORD
DB_HOST=mysql
DB_PORT=3306

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT_SECONDS=300.0
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_THREAD=2

# AI Model Offline Operational Flags (0 = allow download during initial setup, 1 = offline execution)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# PDF Document Storage Configuration (Authoritative limit: 50 MiB = 52428800 bytes)
DOCUMENT_STORAGE_DIR=storage/documents
MAX_PDF_UPLOAD_BYTES=52428800

# Vector Database Configuration
CHROMA_PERSIST_DIR=storage/chroma

# Speech & Translation Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TRANSLATION_MODEL_NAME=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=cpu

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1","http://127.0.0.1:80"]
