# ==============================================================================
# Karnataka Tourist Guide Platform — Frontend Dockerfile
# Multi-stage build: Node 22 Alpine (Compilation) -> Nginx 1.27 Alpine (Serving)
# ==============================================================================

# Stage 1: Compile TypeScript React application with Vite
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency specifications and install deterministically
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy frontend source code and compile production assets
COPY frontend/ ./
RUN npm run build

# Stage 2: Minimal, secure static file serving via Nginx Alpine
FROM nginx:1.27-alpine

# Copy compiled SPA bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom reverse proxy and SPA routing configuration
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Lightweight healthcheck using Alpine's built-in BusyBox wget
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
